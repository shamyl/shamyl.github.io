---
interface Props {
  title?: string;
  subtitle?: string;
  description?: string;
}

const { 
  title = "Shamyl Bin Mansoor",
  subtitle = "Co-founder & CTO @ LearnOBots",
  description = "Technologist · Maker · Educator"
} = Astro.props;
---

<section class="hero">
  <!-- Top metadata bar -->
  <div class="hero-meta">
    <div class="meta-left">
      <span class="meta-label">FIG. 01 — INTRO</span>
      <span class="meta-sub">LAT: 33.6844° N</span>
      <span class="meta-sub">LNG: 73.0479° E</span>
    </div>
    <div class="meta-right">
      <span class="meta-status"><span class="status-dot"></span>SYS_ONLINE</span>
      <span class="meta-sub">ISLAMABAD, PK</span>
      <span class="meta-sub">REF: SBM_IO_V2</span>
    </div>
  </div>

  <!-- Portrait on the right -->
  <div class="hero-portrait">
    <img src="/images/shamyl-portrait.jpg" alt="Shamyl Bin Mansoor" />
    <div class="portrait-fade"></div>
  </div>

  <!-- Hero text -->
  <div class="hero-content">
    <div class="hero-text">
      <div class="hero-label animate-fade-in">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="label-line">
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span class="hero-role">{subtitle}</span>
      </div>
      <h1 class="hero-title animate-fade-in animate-delay-1">
        Shamyl<br><span class="title-outline">Bin Mansoor</span>
      </h1>
      <p class="hero-description animate-fade-in animate-delay-2">{description}</p>
      <p class="hero-tagline animate-fade-in animate-delay-3">
        Building Products that matter
      </p>
      <div class="hero-actions animate-fade-in animate-delay-3">
        <a href="/work" class="btn btn-primary">
          View Work
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/about#contact" class="btn btn-secondary">Get in Touch</a>
      </div>
    </div>
  </div>

  <!-- Bottom meta -->
  <div class="hero-bottom">
    <span class="bottom-text">SPECIALIZED IN ROBOTICS, STEAM EDUCATION, AND PRODUCTS THAT MATTER.</span>
    <span class="bottom-scroll">SCROLL_Y TO INITIALIZE ▼</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 80px 16px 16px;
    position: relative;
    overflow: hidden;
  }

  /* Top metadata */
  .hero-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    z-index: 5;
    position: relative;
    padding: 0 16px;
  }

  .meta-left, .meta-right {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-right {
    text-align: right;
    align-items: flex-end;
  }

  .meta-label {
    font-weight: 700;
    color: var(--text-secondary);
  }

  .meta-sub {
    display: none;
  }

  @media (min-width: 640px) {
    .meta-sub { display: block; }
  }

  .meta-status {
    font-weight: 700;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  /* Portrait */
  .hero-portrait {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 50%;
    z-index: 0;
    overflow: hidden;
  }

  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    opacity: 0.4;
    filter: grayscale(0.2) contrast(1.05);
  }

  :global([data-theme="light"]) .hero-portrait img {
    opacity: 0.5;
    filter: grayscale(0.1) contrast(1);
  }

  .portrait-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right,
      var(--bg-primary) 0%,
      var(--bg-primary) 20%,
      transparent 65%,
      transparent 100%
    );
  }

  :global([data-theme="light"]) .portrait-fade {
    background: linear-gradient(to right,
      var(--bg-primary) 0%,
      var(--bg-primary) 20%,
      transparent 65%,
      transparent 100%
    );
  }

  /* Hero content */
  .hero-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 60px;
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
    padding-left: var(--space-lg);
    padding-right: var(--space-lg);
  }

  .hero-text {
    max-width: 600px;
  }

  .hero-label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .label-line {
    color: var(--accent);
    width: 32px;
    flex-shrink: 0;
  }

  .hero-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: color-mix(in srgb, var(--bg-primary) 90%, transparent);
    padding: 6px 12px;
    backdrop-filter: blur(4px);
  }

  .hero-title {
    font-size: clamp(3rem, 11vw, 7.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-transform: uppercase;
    margin-bottom: 20px;
    opacity: 0;
  }

  .title-outline {
    -webkit-text-stroke: 2px var(--text-primary);
    color: transparent;
    transition: color 0.5s ease;
  }

  .title-outline:hover {
    color: var(--text-primary);
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 8px;
    opacity: 0;
  }

  .hero-tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: var(--space-xl);
    opacity: 0;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    opacity: 0;
  }

  /* Bottom meta */
  .hero-bottom {
    display: none;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid var(--border);
    padding-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    text-transform: uppercase;
    z-index: 5;
    position: relative;
    padding-left: 16px;
    padding-right: 16px;
  }

  @media (min-width: 768px) {
    .hero-bottom { display: flex; }
  }

  .bottom-text {
    max-width: 220px;
    line-height: 1.3;
  }

  .bottom-scroll {
    text-align: right;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-portrait {
      width: 60%;
    }
    .portrait-fade {
      background: linear-gradient(to right,
        var(--bg-primary) 0%,
        var(--bg-primary) 25%,
        transparent 75%
      );
    }
    .hero {
      padding: 80px 8px 16px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: auto;
      padding-top: calc(64px + var(--space-xl));
    }
    
    .hero-portrait {
      width: 65%;
      opacity: 0.5;
    }

    .hero-content {
      padding-bottom: 40px;
    }
    
    .hero-actions {
      flex-direction: column;
    }
    
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
</style>