---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Find current post index in sorted array
const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

// Related articles — find 3 posts sharing tags, exclude current
const currentTags = post.data.tags || [];
let relatedPosts = [];
if (currentTags.length > 0) {
  relatedPosts = sortedPosts
    .filter(p => p.id !== post.id && p.data.tags?.some(tag => currentTags.includes(tag)))
    .slice(0, 3);
}
// Fall back to most recent posts if not enough related
if (relatedPosts.length < 3) {
  const fallback = sortedPosts
    .filter(p => p.id !== post.id && !relatedPosts.includes(p))
    .slice(0, 3 - relatedPosts.length);
  relatedPosts = [...relatedPosts, ...fallback];
}

// Reading time estimation
const wordCount = (post.body || '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};

const siteOrigin = 'https://shamylmansoor.com';
const postUrl = `${siteOrigin}/blog/${post.id}/`;
const dateModified = post.data.dateModified || post.data.date;
const ogImage = post.data.image || undefined;

// Build BlogPosting JSON-LD
const blogPostingJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description || '',
  "image": ogImage ? `${siteOrigin}${ogImage}` : `${siteOrigin}/images/shamyl.jpg`,
  "author": {
    "@type": "Person",
    "name": "Shamyl Bin Mansoor",
    "url": `${siteOrigin}/about/`
  },
  "datePublished": post.data.date.toISOString(),
  "dateModified": dateModified.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  },
  "url": postUrl,
  "keywords": (post.data.tags || []).join(', '),
  "publisher": {
    "@type": "Person",
    "name": "Shamyl Bin Mansoor",
    "url": siteOrigin
  }
});

const seoTitle = post.data.seoTitle || post.data.title;
const seoDescription = post.data.seoDescription || post.data.description || '';
const canonicalUrl = post.data.canonical || postUrl;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  seoTitle={seoTitle}
  seoDescription={seoDescription}
  ogType="article"
  ogImage={ogImage}
  canonical={canonicalUrl}
  jsonLd={blogPostingJsonLd}
>
  <article class="post">
    <header class="post-header">
      <div class="container">
        <a href="/blog" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to Blog
        </a>
        <time class="post-date" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {post.data.dateModified && post.data.dateModified.toISOString() !== post.data.date.toISOString() && (
          <time class="post-modified" datetime={post.data.dateModified.toISOString()}>
            · Updated {formatDate(post.data.dateModified)}
          </time>
        )}
        <span class="reading-time">· {readingTime} min read</span>
        <h1 class="post-title">{post.data.title}</h1>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map(tag => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>
    
    <div class="post-content container">
      <div class="prose">
        <Content />
      </div>
      
      <!-- Author Byline -->
      <div class="author-byline">
        <div class="author-avatar">
          <img src="/images/shamyl.jpg" alt="Shamyl Bin Mansoor" loading="lazy" />
        </div>
        <div class="author-text">
          <p>
            <strong>Shamyl Bin Mansoor</strong> is a technology entrepreneur, product builder and STEAM educator. He is Co-founder and CTO of <a href="https://learnobots.com" target="_blank" rel="noopener noreferrer">LearnOBots</a> and works on educational technology, robotics and interactive learning products. <a href="/about/">Learn more about him</a>.
          </p>
        </div>
      </div>
      
      <!-- Newsletter CTA -->
      <div class="newsletter-cta">
        <p class="newsletter-label">Made in Pakistan — Weekly Newsletter</p>
        <p class="newsletter-desc">Tech, robotics, and EdTech stories from Pakistan and beyond — every week.</p>
        <a href="https://shamylmansoor.substack.com" target="_blank" rel="noopener noreferrer" class="newsletter-link">Subscribe on Substack →</a>
      </div>

      <!-- Prev/Next Navigation -->
      <nav class="post-nav" aria-label="Article navigation">
        {prevPost && (
          <a href={`/blog/${prevPost.id}/`} class="post-nav-item post-nav-prev">
            <span class="post-nav-label">← Previous</span>
            <span class="post-nav-title">{prevPost.data.title}</span>
          </a>
        )}
        {nextPost && (
          <a href={`/blog/${nextPost.id}/`} class="post-nav-item post-nav-next">
            <span class="post-nav-label">Next →</span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </nav>
      
      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <section class="related-articles">
          <h2 class="related-title">Related Articles</h2>
          <div class="related-grid">
            {relatedPosts.map(related => (
              <a href={`/blog/${related.id}/`} class="related-card">
                <time class="related-date" datetime={related.data.date.toISOString()}>
                  {formatDate(related.data.date)}
                </time>
                <h3 class="related-card-title">{related.data.title}</h3>
                {related.data.description && (
                  <p class="related-card-desc">{related.data.description}</p>
                )}
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    padding-top: calc(64px + var(--space-3xl));
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
  }
  
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: var(--space-lg);
    transition: color var(--transition-fast);
  }
  
  .back-link:hover {
    color: var(--accent);
  }
  
  .post-date {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: var(--space-md);
  }
  
  .post-modified {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  
  .reading-time {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  
  .post-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin-bottom: var(--space-md);
    max-width: 800px;
  }
  
  .post-tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }
  
  .post-content {
    padding: var(--space-3xl) 0;
  }
  
  .prose {
    max-width: 720px;
    font-size: 1.1rem;
    line-height: 1.8;
  }
  
  .prose :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-lg);
  }
  
  .prose :global(h3) {
    font-size: 1.25rem;
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
  }
  
  .prose :global(p) {
    margin-bottom: var(--space-lg);
    color: var(--text-secondary);
  }
  
  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  .prose :global(ul), .prose :global(ol) {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
    color: var(--text-secondary);
  }
  
  .prose :global(li) {
    margin-bottom: var(--space-sm);
  }
  
  .prose :global(code) {
    background: var(--bg-tertiary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  
  .prose :global(pre) {
    background: var(--bg-secondary);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-lg);
  }
  
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-lg);
    margin: var(--space-xl) 0;
    font-style: italic;
    color: var(--text-secondary);
  }
  
  .prose :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: var(--space-xl) 0;
  }
  
  /* Author Byline */
  .author-byline {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-3xl);
    padding: var(--space-xl);
    background: var(--bg-secondary);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    max-width: 720px;
  }
  
  .author-avatar {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border);
  }
  
  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .author-text p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }
  
  .author-text a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  
  /* Prev/Next Navigation */
  .post-nav {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    max-width: 720px;
  }
  
  .post-nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }
  
  .post-nav-item:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  
  .post-nav-prev {
    text-align: left;
  }
  
  .post-nav-next {
    text-align: right;
  }
  
  .post-nav-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  
  .post-nav-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  
  /* Related Articles */
  .related-articles {
    margin-top: var(--space-3xl);
    max-width: 720px;
  }
  
  .related-title {
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }
  
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  
  .related-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }
  
  .related-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  
  .related-date {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  
  .related-card-title {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
  }
  
  .related-card-desc {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Newsletter CTA */
  .newsletter-cta {
    margin: var(--space-2xl) 0;
    padding: var(--space-xl);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    max-width: 720px;
  }

  .newsletter-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: var(--space-sm);
    font-weight: 700;
  }

  .newsletter-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .newsletter-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    text-decoration: none;
  }

  .newsletter-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .post-nav {
      flex-direction: column;
    }
    .author-byline {
      flex-direction: column;
      text-align: center;
    }
  }
</style>

<script>
  // Auto-generate Table of Contents from h2 headings
  (function () {
    const prose = document.querySelector('.prose') as HTMLElement | null;
    if (!prose) return;
    const headings = prose.querySelectorAll('h2');
    if (headings.length < 3) return;
    const toc = document.createElement('nav');
    toc.setAttribute('aria-label', 'Table of Contents');
    toc.style.cssText = 'margin:1.5rem 0 2rem;padding:1rem 1.25rem;background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-lg);max-width:720px;';
    const label = document.createElement('p');
    label.textContent = 'Contents';
    label.style.cssText = 'font-family:var(--font-mono);font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:var(--text-muted);margin-bottom:.75rem;font-weight:700;margin-top:0;';
    toc.appendChild(label);
    const ol = document.createElement('ol');
    ol.style.cssText = 'list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.4rem;';
    headings.forEach((h, i) => {
      if (!h.id) h.id = 'toc-h-' + i;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = '#' + h.id;
      a.style.cssText = 'font-family:var(--font-mono);font-size:.75rem;color:var(--text-secondary);text-decoration:none;display:flex;align-items:baseline;gap:.5rem;';
      const num = document.createElement('span');
      num.textContent = String(i + 1).padStart(2, '0');
      num.style.cssText = 'color:var(--text-muted);font-size:.6rem;flex-shrink:0;';
      a.appendChild(num);
      a.appendChild(document.createTextNode(h.textContent || ''));
      a.addEventListener('mouseenter', () => { a.style.color = 'var(--accent)'; });
      a.addEventListener('mouseleave', () => { a.style.color = 'var(--text-secondary)'; });
      li.appendChild(a);
      ol.appendChild(li);
    });
    toc.appendChild(ol);
    const firstP = prose.querySelector('p');
    if (firstP && firstP.nextSibling) {
      prose.insertBefore(toc, firstP.nextSibling);
    } else {
      prose.prepend(toc);
    }
  })();
</script>